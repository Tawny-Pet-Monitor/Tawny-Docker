# Copy to .env (which is gitignored). Compose substitutes these at `up`.

# Tailscale auth key for the container's own tailscaled. Reusable, non-ephemeral.
# Leave blank to run in host-socket mode (mount the host's tailscaled) or to
# paste the key into the /setup page instead. See README.md.
TS_AUTHKEY=

# Optional: hostname the node joins as (default: tawny).
# TS_HOSTNAME=tawny

# Meeting points (how two devices find each other). Defaults are fine.
# TAWNY_RELAY=on              # this box's own relay at /relay
# TAWNY_NOSTR_RELAYS=         # empty: three public relays too. off: this box only
# TAWNY_NOSTR_MODE=prefer     # off: pair the old way, with no relays
# TAWNY_ONLY_THIS_BOX=off     # on: pairing through this box only, no public relay.
#                             # Open /setup first: it shows what to check before you switch it on
